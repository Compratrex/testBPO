{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=wholesale_platform;Username=wholesale_app;Password=local-dev-password"
  },
  "Jwt": {
    "Issuer": "WholesalePlatform",
    "Audience": "WholesalePlatform.Client",
    "Secret": "development-only-secret-value-with-at-least-32-bytes",
    "ExpiresMinutes": 30
  },
  "BootstrapAdmin": {
    "Enabled": true,
    "UseBuiltInDevelopmentAdmin": true
  },
  "Database": {
    "ApplyMigrationsOnStartup": true
  }
}
